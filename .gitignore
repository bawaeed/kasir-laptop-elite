# ==========================================
# 🛠️ DEPENDENCIES (SAMPAH PEMBANGUNAN)
# ==========================================
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# 🚀 NEXT.JS & PRODUCTION
# ==========================================
.next/
out/
build
dist
.vercel

# ==========================================
# 🔐 SECURITY & SECRETS (RAHASIA NEGARA)
# ==========================================
# Sangat krusial agar password database tidak bocor ke publik
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env*
*.pem

# ==========================================
# 💎 PRISMA
# ==========================================
# Abaikan file env di dalam folder prisma jika ada
/prisma/.env
# Abaikan log sqlite jika tidak sengaja terpakai
*.db
*.db-journal

# ==========================================
# 📷 UPLOADS & ASSETS (FILE BERAT)
# ==========================================
# Vercel tidak menyimpan file secara permanen, jadi folder ini diabaikan
/public/uploads/*
# Kecuali file .gitkeep agar folder tetap terbaca oleh Git untuk struktur
!/public/uploads/.gitkeep

# ==========================================
# 💻 SYSTEM & LOGS
# ==========================================
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts