generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 🔥 KOSONGKAN DI SINI SESUAI ATURAN PRISMA 7 🔥
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  role     String @default("karyawan")

  @@map("Users")
}

model Laptop {
  id              Int      @id @default(autoincrement())
  date_in         DateTime @default(now())
  sku_code        String   @unique
  brand           String
  model           String
  specs           String?
  condition_notes String?
  cost_price      Decimal? @db.Decimal(12, 2)
  repair_cost     Decimal? @db.Decimal(12, 2)
  sparepart_cost  Decimal? @db.Decimal(12, 2)
  target_price    Decimal? @db.Decimal(12, 2)
  image_url       String?
  status          String   @default("Tersedia")
  updated_at      DateTime @updatedAt

  @@map("Laptop")
}

model LogAktifitas {
  id         Int      @id @default(autoincrement())
  user_id    String?
  aktivitas  String
  keterangan String?
  waktu      DateTime @default(now())

  @@map("LogAktifitas")
}